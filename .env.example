# Copy to .env and fill locally. Never commit real values.

# --- Required for default demo: none of the keys below ---
# Python + Node are enough. Leave Razorpay/LLM blank.

# Razorpay (optional — dry_run works without these).
# In Rebound's mvp_mode, use only Razorpay Test Mode credentials (rzp_test_...).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required only when testing a signed public webhook; this is not the API Key Secret.
RAZORPAY_WEBHOOK_SECRET=

# Rebound
# Allowed values: dry_run (default) | mvp_mode. There is no production/live execution mode.
REBOUND_EXECUTION_MODE=dry_run
REBOUND_ENABLE_LLM_PROPOSER=false
DATABASE_URL=sqlite:///./rebound.db
POLICY_VERSION=mvp-v1

# App (must match Vite defaults for CORS)
APP_URL=http://localhost:5173
API_URL=http://localhost:8000

# Frontend (optional — leave empty to use Vite /api proxy)
# VITE_API_URL=

# Optional OpenAI proposer — disabled by default. It can only propose; policy still gates every action.
# To enable locally: REBOUND_ENABLE_LLM_PROPOSER=true and add an OPENAI_API_KEY below.
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
