# Copy to .env and fill locally. Never commit real values.

# Razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# LLM / AI providers (fill only what you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Rebound
REBOUND_EXECUTION_MODE=dry_run
REBOUND_ENABLE_LLM_PROPOSER=false
DATABASE_URL=sqlite:///./rebound.db

# App
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NODE_ENV=development
